{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NudgeResponse",
  "description": "Untangle 제안 카드 응답 v0.3. 개수와 길이 제한은 프롬프트 규칙과 앱 검증으로 처리한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["nudges"],
  "properties": {
    "nudges": {
      "type": "array",
      "description": "0~3장. focus 최대 2장, explore 최대 1장.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slot",
          "topic_id",
          "new_topic_name",
          "type",
          "title",
          "action",
          "est_minutes",
          "why_now",
          "evidence",
          "head_start",
          "first_step"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "이번 응답 안에서 고유한 임시 ID (n1, n2, n3). 저장용 ID는 앱이 붙인다."
          },
          "slot": {
            "type": "string",
            "enum": ["focus", "explore"],
            "description": "focus=지금 이어가기(continue, unblock), explore=이런 것도 있어요(expand, new_project)."
          },
          "topic_id": {
            "type": "string",
            "description": "입력 topics 중 하나의 id. new_project일 때만 'new'."
          },
          "new_topic_name": {
            "type": ["string", "null"],
            "description": "new_project일 때 새 토픽의 이름. 그 외에는 null."
          },
          "type": {
            "type": "string",
            "enum": ["continue", "unblock", "expand", "new_project"],
            "description": "continue=하던 일의 다음 한 걸음, unblock=막힌 지점을 푸는 질문 하나, expand=기존 토픽을 넓히는 새 방향, new_project=사용자 맥락에서 나온 새 시도."
          },
          "title": {
            "type": "string",
            "description": "동사로 끝나는 한 줄 행동. 40자 이내."
          },
          "action": {
            "type": "string",
            "description": "사용자가 무엇을 어디까지 하면 끝인지. 두 문장 이내."
          },
          "est_minutes": {
            "type": "integer",
            "description": "action 전체의 예상 시간(분). 1~30."
          },
          "why_now": {
            "type": "string",
            "description": "왜 이 사람에게, 왜 지금인지. evidence에 근거한 1~2문장."
          },
          "evidence": {
            "type": "array",
            "description": "1~3개.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "fact"],
              "properties": {
                "source": {
                  "type": "string",
                  "enum": ["profile", "topic", "feedback"]
                },
                "fact": {
                  "type": "string",
                  "description": "입력에 실제로 있는 사실 한 줄."
                }
              }
            }
          },
          "head_start": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "content", "options"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["draft", "outline", "checklist", "question"],
                "description": "unblock이면 question, 그 외에는 draft/outline/checklist."
              },
              "content": {
                "type": "string",
                "description": "AI가 미리 만든 결과물 또는 질문 하나. 마크다운, 600자 이내."
              },
              "options": {
                "type": "array",
                "description": "kind=question일 때 답변 선택지 2~4개. 그 외에는 빈 배열.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label", "value"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string", "description": "버튼 문구. 20자 이내." },
                    "value": { "type": "string", "description": "이 선택지가 뜻하는 답변 한 문장." }
                  }
                }
              }
            }
          },
          "first_step": {
            "type": "string",
            "description": "수락 직후 2분 안에 할 수 있는 선택·확인·수정 한 줄."
          }
        }
      }
    }
  }
}
